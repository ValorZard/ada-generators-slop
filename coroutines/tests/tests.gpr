with "coroutines.gpr";

project Tests is
   for Languages use ("Ada");
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "exe";
   for Main use
     ("test_empty.adb",

      "test_kill_twice.adb",
      "test_kill_main.adb",
      "test_foreign_kill.adb",

      "test_delegate_nonlocal_ref.adb",

      "test_spawn_twice.adb",
      "test_spawn_exit.adb",
      "test_spawn_kill.adb",
      "test_spawn_switch_exit.adb",
      "test_spawn_switch_kill.adb",

      "test_switch_dead.adb",
      "test_switch_self.adb",

      "test_resume_simple.adb",
      "test_resume_chained.adb",
      "test_resume_parent_dead.adb",

      "test_reference_loop.adb",
      "test_secondary_stack.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwae", "-gnatyg", "-gnatX");

      --  test_secondary_stack declares helpers taking Delegate'Class as
      --  "in out" and only reads them. That was silent while Coroutines.
      --  Coroutine was an Ada.Finalization.Controlled type -- GNAT does not
      --  warn about an unwritten controlled formal -- and started warning
      --  when it became a Finalizable record. -gnatwK/-gnatwU turn those two
      --  warnings off for this file alone, so the test source stays exactly
      --  as it was.
      for Switches ("test_secondary_stack.adb") use
        ("-gnat2022", "-gnatwae", "-gnatyg", "-gnatX", "-gnatwK", "-gnatwU");
   end Compiler;
end Tests;
