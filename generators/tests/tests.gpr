with "generators.gpr";

project Tests is
   for Languages use ("Ada");
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "exe";
   for Main use
     ("test_empty.adb",
      "test_once_kill.adb",
      "test_twice_kill.adb",
      "test_stop_resume.adb",
      "test_complete.adb",
      "test_chained.adb",
      "test_work_stealing.adb",
      "test_migrate_midway.adb",
      "test_advance_after_move.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwae", "-gnatyg", "-gnatX");
   end Compiler;
end Tests;
